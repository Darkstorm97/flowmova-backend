                  "    pm.expect(json.items).to.be.an('array');",
                  "    pm.expect(json).to.have.property('page');",
                  "    pm.expect(json).to.have.property('size');",
                  "    pm.expect(json).to.have.property('totalItems');",
                  "    pm.expect(json).to.have.property('totalPages');",
                  "    json.items.forEach(function (company) {",
                  "        pm.expect(company).to.have.property('status', 'ACTIVE');",
                  "        pm.expect(company).to.not.have.property('role');",
                  "    });",
                  "});"
