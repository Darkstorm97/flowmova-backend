          "name": "Create Catalog Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains created catalog category fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('companyId', pm.collectionVariables.get('companyId'));",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('displayOrder');",
                  "    pm.expect(json).to.have.property('status', 'ACTIVE');",
                  "    pm.expect(json).to.have.property('createdAt');",
                  "    pm.expect(json).to.have.property('updatedAt');",
                  "    pm.collectionVariables.set('catalogCategoryId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
